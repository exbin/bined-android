<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:flexDirection="row"
    app:flexWrap="wrap"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".MainActivity"
    tools:showIn="@layout/activity_main">

    <TextView
        android:id="@+id/charset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="7"
        android:text="Charset"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/documentSizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:longClickable="true"
        android:onClick="editSelection"
        android:ems="7"
        android:text="Position"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/cursorPositionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:longClickable="true"
        android:onClick="goToPosition"
        android:ems="7"
        android:text="Cursor"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/memoryModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="1"
        android:text="\?"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/editModeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:longClickable="true"
        android:onClick="cycleEditMode"
        android:ems="3"
        android:text="\?"
        tools:ignore="HardcodedText" />

</com.google.android.flexbox.FlexboxLayout>